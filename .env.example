# Dipakai HANYA oleh docker-compose.yml di folder ini (root) -- bukan
# .env aplikasi backend/frontend, yang masing-masing punya .env.example
# sendiri (backend/.env.example, frontend/.env.example) untuk `npm run dev`
# biasa tanpa Docker.
#
# Variabel di sini cuma dipakai compose untuk mem-bake nilai publik ke build
# frontend (VITE_*) dan menyalin kredensial Postgres ke servis `db`. Salin
# jadi `.env` di folder ini sebelum menjalankan `docker compose up`.

DB_USER=postgres
DB_PASSWORD=change_this
DB_NAME=zentra_prod

# URL publik backend yang bisa diakses BROWSER pengguna (bukan "localhost"
# atau nama servis Docker seperti "backend") -- di-bake ke build frontend,
# jadi harus alamat yang benar-benar bisa dijangkau dari luar server.
VITE_API_URL=https://api.contoh-domain-anda.com/api

# Kosongkan untuk mematikan tombol "Masuk/Daftar dengan Google" -- lihat
# frontend/.env.example untuk cara mendapatkan nilainya.
VITE_GOOGLE_CLIENT_ID=
