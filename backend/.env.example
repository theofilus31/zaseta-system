PORT=4000
# PostgreSQL (bukan lagi MySQL/MariaDB — lihat src/config/db.js).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=zentra_dev
# WAJIB string acak, minimal 32 karakter — server MENOLAK MENYALA kalau ini
# kosong/terlalu pendek/masih nilai contoh (lihat app.js). Siapa pun yang tahu
# nilai ini bisa memalsukan token masuk untuk akun mana pun. Buat sendiri,
# mis.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5174

# Jumlah lapis reverse proxy/load balancer DI DEPAN Node (lihat app.js) —
# bawaan 1 cocok untuk topologi paling umum (satu Nginx/PaaS langsung di
# depan). Naikkan kalau ada lebih dari satu lapis (mis. Cloudflare + Nginx = 2).
TRUST_PROXY_HOPS=1

# SMTP — pengirim email OTP ganti email DAN digest email notifikasi harian.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=helpdesk@example.com
SMTP_PASS=change_this
SMTP_FROM="IT Asset Inventory <helpdesk@example.com>"

# Digest email notifikasi harian ("perlu ditindaklanjuti": garansi, pengingat,
# pemeliharaan, stok menipis, permintaan tertunda) — butuh SMTP di atas sudah
# terisi. Set ke 'false' untuk mematikan (mis. saat mengembangkan lokal).
EMAIL_DIGEST_ENABLED=true
# Jam pengiriman, 0-23, waktu Asia/Jakarta.
EMAIL_DIGEST_HOUR=7

# Billing (Fase 4 SaaS) — provider aktif untuk services/paymentGateway/
# (lihat index.js). 'pakasir' (bawaan, dan SATU-SATUNYA provider yang ada
# sekarang) = upgrade paket berbayar dibayar & dikonfirmasi otomatis lewat
# Pakasir (lihat PakasirProvider.js) -- WAJIB diisi PAKASIR_* di bawah,
# tidak ada lagi jalur transfer manual sebagai cadangan.
PAYMENT_GATEWAY_PROVIDER=pakasir

# Pakasir (https://pakasir.com/p/docs) — payment gateway API v2. PAKASIR_SLUG
# & PAKASIR_API_KEY dari halaman proyek Pakasir Anda. PAKASIR_WEBHOOK_SECRET
# = "Secret" yang sama di halaman itu (dicocokkan lewat header X-Secret saat
# Pakasir memanggil POST /api/billing/webhooks/pakasir). Upgrade paket
# berbayar TIDAK akan berfungsi kalau ini kosong.
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=

# Masuk/Daftar dengan Google (Google Identity Services) — Client ID dari
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (tipe "Web application", Authorized JavaScript origins diisi URL frontend
# ini). Cuma Client ID, TIDAK perlu Client Secret — lihat utils/googleAuth.js.
# Tombol "Masuk/Daftar dengan Google" otomatis tersembunyi kalau ini kosong
# (lihat frontend VITE_GOOGLE_CLIENT_ID di frontend/.env).
GOOGLE_CLIENT_ID=
