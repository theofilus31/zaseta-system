PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=it_asset_inventory
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173

# SMTP — pengirim email OTP ganti email
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=helpdesk@example.com
SMTP_PASS=change_this
SMTP_FROM="IT Asset Inventory <helpdesk@example.com>"

# Zecode — asisten AI internal, jalan lewat Ollama lokal. Opsional: kalau
# dikosongkan, otomatis pakai nilai di bawah ini sebagai default. Ganti kalau
# Ollama berjalan di host/container terpisah, atau ingin memakai model lain.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
