VITE_API_URL=http://localhost:4000/api

# Masuk/Daftar dengan Google — Client ID OAuth dari Google Cloud Console
# (tipe "Web application"). Client ID BUKAN rahasia (aman terlihat di
# browser) — beda dari Client Secret yang tidak dipakai sama sekali di sini.
# Tombol Google otomatis tersembunyi kalau ini kosong.
VITE_GOOGLE_CLIENT_ID=
